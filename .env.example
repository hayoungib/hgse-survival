# Copy this file to .env and fill it in. NEVER commit .env to GitHub.
# Leave ANTHROPIC_API_KEY empty to play with built-in event text (no AI, no cost).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=3000

# Game rules
DAY_REAL_MINUTES=24   # real minutes per in-game day (use 3 while testing)
SEMESTER_DAYS=14      # days until graduation
MAX_BURNOUTS=3        # burning out MORE than this many times ends the run
